#!/usr/bin/env bash
# Team chat UI — the user's seat on this workspace's coord bus.
#
#   tools/coord-web                 start the chat UI (port from .devin/coord.json)
#   tools/coord-web --port 8080     somewhere else
#   tools/coord-web --restart       kill the listener on the port and relaunch detached
#   tools/coord-web --stand-down    release the never-end stop hook so seats can close turns
#   tools/coord-web --resume        put the team back in the loop
#
# The page also has the recess button (stop the team and hold a recess) and the
# stand-down toggle; tools/coord-recess does the same thing from a shell.
#
# Everything after the flags below is passed through to the server.

set -euo pipefail

canonical="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../.." && pwd)"
root="${DEVIN_PROJECT_DIR:-}"
if [ -z "$root" ]; then
    dir="$(pwd)"
    while [ "$dir" != "/" ]; do
        if [ -d "$dir/.devin" ]; then
            root="$dir"
            break
        fi
        dir="$(dirname "$dir")"
    done
fi
if [ -z "$root" ]; then
    echo "coord-web: cannot locate the workspace (.devin/ not found above cwd; set DEVIN_PROJECT_DIR)" >&2
    exit 1
fi

stand_down="$root/.devin/collaboration/stand-down"
restart=0

while [ $# -gt 0 ]; do
    case "$1" in
        --stand-down)
            mkdir -p "$(dirname "$stand_down")"
            printf '%s — stand-down requested from the command line\n' "$(date -Iseconds)" > "$stand_down"
            echo "stand-down active: $stand_down"
            shift
            ;;
        --resume)
            rm -f "$stand_down"
            echo "stand-down lifted"
            shift
            ;;
        --restart)
            restart=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

port="${COORD_CHAT_PORT:-}"
if [ -z "$port" ]; then
    port="$(node -e 'try{const c=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));console.log(c.port??c.chatPort??"")}catch{console.log("")}' "$root/.devin/coord.json" 2>/dev/null || true)"
fi
prev=""
for arg in "$@"; do
    case "$arg" in --port=*) port="${arg#--port=}" ;; esac
    [ "$prev" = "--port" ] && port="$arg"
    prev="$arg"
done
port="${port:-7777}"
# server.mjs reads COORD_CHAT_PORT; an explicit --port in "$@" still wins inside
# it (args.port ?? env). Without this the computed port was dead code and every
# launch landed on the server default.
export COORD_CHAT_PORT="$port"

if [ "$restart" -eq 1 ]; then
    pid="$(ss -tlnpH 2>/dev/null | awk -v port=":$port" '$4 ~ port"$"' | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2 || true)"
    if [ -n "$pid" ]; then
        kill "$pid"
        for _ in $(seq 1 25); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.2
        done
    fi
    mkdir -p "$root/.devin/agent-coord/state"
    setsid nohup env DEVIN_PROJECT_DIR="$root" node "$canonical/core/chat/server.mjs" "$@" >>"$root/.devin/agent-coord/state/chat-server.log" 2>&1 &
    echo "coord-web restarted detached on port $port (pid $!), log: .devin/agent-coord/state/chat-server.log"
    exit 0
fi

if [ -f "$stand_down" ] && [ $# -eq 0 ]; then
    echo "note: stand-down is active; seats may end their turns until you run --resume" >&2
fi

exec env DEVIN_PROJECT_DIR="$root" node "$canonical/core/chat/server.mjs" "$@"
