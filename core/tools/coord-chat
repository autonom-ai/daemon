#!/usr/bin/env bash
# Terminal seat on this workspace's coord bus (the coord package's own TUI),
# for when a browser is not what you want. Same room, same messages, same
# seat id.
#
#   tools/coord-chat            join as $USER
#   tools/coord-chat --id cet   join under an explicit seat id
#
# Inside: plain text posts to the current channel; /dm <seat> <text> for a
# direct message; /rooms, /list, /topic, /doctor, /help for the rest.

set -euo pipefail

canonical="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../.." && pwd)"
root="${DEVIN_PROJECT_DIR:-}"
if [ -z "$root" ]; then
    dir="$(pwd)"
    while [ "$dir" != "/" ]; do
        if [ -d "$dir/.devin" ]; then
            root="$dir"
            break
        fi
        dir="$(dirname "$dir")"
    done
fi
if [ -z "$root" ]; then
    echo "coord-chat: cannot locate the workspace (.devin/ not found above cwd; set DEVIN_PROJECT_DIR)" >&2
    exit 1
fi

state="$root/.devin/agent-coord/state"
tui="$canonical/node_modules/agent-coord-mcp/scripts/coord-chat.mjs"

if [ ! -f "$tui" ]; then
    echo "coord-chat is missing — run: npm ci --ignore-scripts --prefix $canonical" >&2
    exit 1
fi

mkdir -p "$state"
export AGENT_COORD_DIR="$state"

exec node "$tui" --dir "$state" "$@"
