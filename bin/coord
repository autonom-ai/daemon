#!/usr/bin/env node
// coord — the one script for team coordination.
//
//   coord init <workspace> [--project name] [--seats b:ada,c:grace,...]
//       Wire a workspace for coordination: state dir, mcp_config seat entries,
//       chat+hooks symlinks to the canonical repo, COORDINATION.md/ORGANICS.md
//       copies (never clobbered), AGENTS.md managed block, port allocation.
//
//   coord seat add <workspace> <seat>:<identity>
//       Add one more seat's MCP entry + seat→identity mapping.
//
//   coord chat start|stop|status|restart <workspace> [--port N]
//       Run the canonical chat server against the workspace's bus.
//
//   coord update <workspace>
//       Re-verify symlinks and templates; warn on divergent stray copies.
//
//   coord identity add <name> [--display "Display Name"]
//       Scaffold a global identity under the machine state dir
//       (~/.local/state/agent-coord/agents/<name>/identity.md + memory.md).
//
// Everything is self-fulfilling: seats only need their name and seat letter;
// identity, memory, and display names come from the canonical registry.

import { execFileSync, spawn } from "node:child_process";
import os from "node:os";
import { existsSync, mkdirSync, readFileSync, symlinkSync, unlinkSync, writeFileSync, readdirSync, lstatSync, readlinkSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const CORE_CHAT = path.join(ROOT, "core", "chat");
const CORE_HOOKS = path.join(ROOT, "core", "hooks");
const CORE_TOOLS = path.join(ROOT, "core", "tools");
// Machine-local state — the identity registry and port allocations belong to
// this machine's user, not the repository. Override with AGENT_COORD_HOME for
// the whole state dir, or AGENT_COORD_AGENTS for just the identity registry —
// the same override the hooks honor (core/hooks/coord.mjs), so a test run
// cannot write into the real registry by accident.
const STATE_HOME = process.env.AGENT_COORD_HOME ??
    path.join(process.env.XDG_STATE_HOME ?? path.join(os.homedir(), ".local", "state"), "agent-coord");
const AGENTS_DIR = process.env.AGENT_COORD_AGENTS ?? path.join(STATE_HOME, "agents");
const TEMPLATES = path.join(ROOT, "templates");
const PORTS_FILE = path.join(STATE_HOME, "ports.json");
const SERVER_JS = path.join(ROOT, "node_modules", "agent-coord-mcp", "dist", "server.js");
const AGENTS_BLOCK_BEGIN = "<!-- agent-coord:begin -->";
const AGENTS_BLOCK_END = "<!-- agent-coord:end -->";
const LEGACY_BLOCK_BEGIN = "<!-- devin-coord:begin -->";
const LEGACY_BLOCK_END = "<!-- devin-coord:end -->";

function fail(msg)
{
    console.error(`coord: ${msg}`);
    process.exit(1);
}

function parseFlags(argv)
{
    const ret = { _: [] };
    for (let i = 0; i < argv.length; i++)
    {
        const arg = argv[i];
        if (!arg.startsWith("--"))
        {
            ret._.push(arg);
            continue;
        }
        const match = /^--([^=]+)(?:=(.*))?$/.exec(arg);
        if (match)
            ret[match[1]] = match[2] ?? argv[++i];
    }
    return ret;
}

function readJson(file, fallback)
{
    try { return JSON.parse(readFileSync(file, "utf8")); }
    catch { return fallback; }
}

function writeJson(file, data)
{
    mkdirSync(path.dirname(file), { recursive: true });
    writeFileSync(file, `${JSON.stringify(data, null, 2)}\n`, "utf8");
}

function ports()
{
    return readJson(PORTS_FILE, { allocations: {} });
}

function allocPort(project)
{
    const table = ports();
    table.allocations ??= {};
    if (table.allocations)
    {
        for (const [port, owner] of Object.entries(table.allocations))
            if (owner === project)
                return Number(port);
    }
    const used = new Set(Object.keys(table.allocations).map(Number));
    let port = 7777;
    while (used.has(port))
        port++;
    table.allocations[String(port)] = project;
    writeJson(PORTS_FILE, table);
    return port;
}

function ensureLink(target, link)
{
    if (lstatSync(link, { throwIfNoEntry: false })?.isSymbolicLink())
    {
        if (readlinkSync(link) === target)
            return "ok";
        unlinkSync(link);
    }
    else if (existsSync(link))
        return "exists";
    mkdirSync(path.dirname(link), { recursive: true });
    symlinkSync(target, link);
    return "linked";
}

function stateDirOf(workspace)
{
    return path.join(workspace, ".devin", "agent-coord", "state");
}

function coordJsonOf(workspace)
{
    return readJson(path.join(workspace, ".devin", "coord.json"), null);
}

function seatEntry(workspace, identity)
{
    return {
        command: "node",
        args: [SERVER_JS],
        env: {
            AGENT_COORD_DIR: stateDirOf(workspace),
            AGENT_COORD_BOUND_AGENT: identity,
        },
    };
}

function writeMcpSeat(workspace, seat, identity)
{
    const file = path.join(workspace, ".devin", "mcp_config.json");
    const config = readJson(file, { mcpServers: {} });
    config.mcpServers ??= {};
    config.mcpServers[`agent-coord-${seat}`] = seatEntry(workspace, identity);
    writeJson(file, config);
}

function appendAgentsBlock(workspace, project)
{
    const file = path.join(workspace, "AGENTS.md");
    const block = `
${AGENTS_BLOCK_BEGIN}

## Team coordination

This workspace runs a coordinated agent team. Read **COORDINATION.md** (how the
room works: bus, rooms, seats, recess) and **ORGANICS.md** (team personality —
how to act like a person here, not a process). Both are workspace copies; edit
ORGANICS.md to tune this team's default behavior.

- The bus is \`.devin/agent-coord/state/\` via the \`agent-coord-<seat>\` MCP server.
- Your seat and identity are in \`.devin/coord.json\`; your memory lives in the
  machine's identity registry at \`~/.local/state/agent-coord/agents/<you>/\` —
  read it at session start, add to it before
  you stop.
- The team chat UI: \`coord chat start ${project}\` then open the printed URL.

${AGENTS_BLOCK_END}
`;
    let current = existsSync(file) ? readFileSync(file, "utf8") : "";
    // Workspaces wired before the rename still carry the devin-coord markers;
    // translate them in place rather than appending a second block.
    if (current.includes(LEGACY_BLOCK_BEGIN))
        current = current.replace(LEGACY_BLOCK_BEGIN, AGENTS_BLOCK_BEGIN).replace(LEGACY_BLOCK_END, AGENTS_BLOCK_END);
    if (current.includes(AGENTS_BLOCK_BEGIN))
    {
        const re = new RegExp(`${AGENTS_BLOCK_BEGIN}[\\s\\S]*?${AGENTS_BLOCK_END}`);
        current = current.replace(re, block.trim());
    }
    else
        current = `${current.trimEnd()}\n\n${block.trim()}\n`;
    writeFileSync(file, current, "utf8");
}

function copyTemplate(name, workspace)
{
    const src = path.join(TEMPLATES, name);
    const dest = path.join(workspace, name);
    if (!existsSync(src))
        return "missing-template";
    if (existsSync(dest))
        return "kept-local";
    writeFileSync(dest, readFileSync(src, "utf8"), "utf8");
    return "copied";
}

// Skills render {{PROJECT}} into their frontmatter name, so they cannot be
// symlinks — copy each file with the substitution applied.
function installSkill(skill, project, devin)
{
    const srcDir = path.join(ROOT, "core", "skills", skill);
    const destDir = path.join(devin, "skills", `${project}-${skill}`);
    if (!existsSync(srcDir))
        return "missing-skill";
    if (existsSync(destDir))
        return "kept-local";
    mkdirSync(destDir, { recursive: true });
    for (const name of readdirSync(srcDir))
    {
        const raw = readFileSync(path.join(srcDir, name), "utf8");
        writeFileSync(path.join(destDir, name), raw.replaceAll("{{PROJECT}}", project), "utf8");
    }
    return "rendered";
}

function cmdInit(workspace, flags)
{
    if (!workspace)
        fail("init needs a workspace dir");
    mkdirSync(workspace, { recursive: true });
    const project = flags.project ?? path.basename(workspace);
    const devin = path.join(workspace, ".devin");
    for (const dir of ["agent-coord/state", "collaboration"])
        mkdirSync(path.join(devin, dir), { recursive: true });

    const seats = {};
    const seatSpec = flags.seats ?? "";
    for (const pair of String(seatSpec).split(","))
    {
        const [seat, identity] = pair.split(":").map((part) => part?.trim());
        if (seat && identity)
            seats[seat] = identity;
    }
    if (!Object.keys(seats).length)
        console.error("note: no --seats given; add later with `coord seat add <ws> <seat>:<identity>`");

    const port = allocPort(project);
    const coord = {
        project,
        chatPort: port,
        port,
        human: flags.human ?? process.env.USER ?? "user",
        humanSeat: flags.human ?? process.env.USER ?? "user",
        teamRoom: "general",
        seats,
        teamSkill: `${project}-team`,
        recessSkill: `${project}-recess`,
        coordRoot: ROOT,
    };
    writeJson(path.join(devin, "coord.json"), coord);

    for (const [seat, identity] of Object.entries(seats))
        writeMcpSeat(workspace, seat, identity);

    const chatLink = ensureLink(CORE_CHAT, path.join(devin, "chat"));
    const hooksLink = ensureLink(CORE_HOOKS, path.join(devin, "hooks"));
    const toolsLink = ensureLink(CORE_TOOLS, path.join(workspace, "tools", "coord"));
    const skillResults = ["team", "recess"].map((skill) => `${skill}: ${installSkill(skill, project, devin)}`);

    const coordMd = copyTemplate("COORDINATION.md", workspace);
    const organics = copyTemplate("ORGANICS.md", workspace);
    appendAgentsBlock(workspace, project);

    // hooks.v1.json is generated pointing at the canonical hooks — it is the
    // wiring, the hook code itself comes through the symlink.
    const hooksConfig = path.join(devin, "hooks.v1.json");
    if (!existsSync(hooksConfig) && existsSync(path.join(TEMPLATES, "hooks.v1.json")))
        writeFileSync(hooksConfig, readFileSync(path.join(TEMPLATES, "hooks.v1.json"), "utf8"), "utf8");

    console.log(`coord: wired '${project}' (${workspace})`);
    console.log(`  port:        ${port}`);
    console.log(`  seats:       ${JSON.stringify(seats)}`);
    console.log(`  chat link:   ${chatLink}`);
    console.log(`  hooks link:  ${hooksLink}`);
    console.log(`  tools link:  ${toolsLink}`);
    console.log(`  skills:      ${skillResults.join("  ")}`);
    console.log(`  COORDINATION.md: ${coordMd}   ORGANICS.md: ${organics}`);
    console.log(`  next: coord chat start ${workspace}`);
}

function cmdSeatAdd(workspace, spec)
{
    if (!workspace || !spec)
        fail("seat add needs <workspace> and <seat>:<identity>");
    const [seat, identity] = spec.split(":").map((part) => part?.trim());
    if (!seat || !identity)
        fail("seat spec must look like b:ada");
    const coordFile = path.join(workspace, ".devin", "coord.json");
    const coord = readJson(coordFile, null) ?? fail(`no .devin/coord.json in ${workspace} — run coord init first`);
    coord.seats ??= {};
    coord.seats[seat] = identity;
    writeJson(coordFile, coord);
    writeMcpSeat(workspace, seat, identity);
    if (!existsSync(path.join(AGENTS_DIR, identity)))
        cmdIdentityAdd(identity, {});
    console.log(`coord: seat ${seat} → ${identity} in ${coord.project}`);
}

function portOf(workspace)
{
    const coord = coordJsonOf(workspace);
    if (coord?.chatPort ?? coord?.port)
        return coord.chatPort ?? coord.port;
    return allocPort(coord?.project ?? path.basename(workspace));
}

function listenerPid(port)
{
    try
    {
        const out = execFileSync("ss", ["-tlnpH"], { encoding: "utf8" });
        for (const line of out.split("\n"))
        {
            if (!line.includes(`:${port}`))
                continue;
            const match = /pid=(\d+)/.exec(line);
            if (match)
                return match[1];
        }
    }
    catch { }
    return null;
}

// The respawn wrapper's command line embeds this workspace's logFile path —
// the reliable handle for finding wrappers, including ones started before
// pidfiles existed. Each wrapper is its own process-group leader (detached),
// so killing -pid takes the bash loop and the node child down together.
function wrapperPids(workspace)
{
    const logFile = path.join(stateDirOf(workspace), "chat-server.log");
    try
    {
        const out = execFileSync("pgrep", ["-f", logFile], { encoding: "utf8" });
        return out.split("\n").filter(Boolean).map(Number);
    }
    catch { return []; }
}

function killChat(workspace, port)
{
    const stateDir = stateDirOf(workspace);
    const pidFile = path.join(stateDir, "chat-server.pid");
    const targets = new Set(wrapperPids(workspace));
    if (existsSync(pidFile))
    {
        targets.add(Number(readFileSync(pidFile, "utf8").trim()));
        unlinkSync(pidFile);
    }
    for (const pid of targets)
        try { process.kill(-pid); } catch { }
    const pid = listenerPid(port);
    if (pid)
        try { process.kill(Number(pid)); } catch { }
    return targets.size > 0 || pid !== null;
}

function cmdChat(action, workspace, flags)
{
    if (!workspace)
        fail(`chat ${action} needs a workspace dir`);
    const coord = coordJsonOf(workspace) ?? {};
    const project = coord.project ?? path.basename(workspace);
    const port = Number(flags.port ?? coord.chatPort ?? coord.port ?? allocPort(project));
    const logFile = path.join(stateDirOf(workspace), "chat-server.log");
    mkdirSync(stateDirOf(workspace), { recursive: true });

    if (action === "status")
    {
        const pid = listenerPid(port);
        console.log(pid ? `chat UP on :${port} (pid ${pid})` : `chat DOWN on :${port}`);
        return;
    }
    if (action === "stop" || action === "restart")
    {
        if (!killChat(workspace, port))
            console.log(`chat: nothing running for '${project}' on :${port}`);
        else
            console.log(`chat stopped for '${project}' on :${port}`);
        if (action === "stop")
            return;
    }
    if (action === "start" || action === "restart")
    {
        // A live wrapper alone means running — the node child may still be
        // binding the port, so listenerPid is not a reliable dedupe signal
        // this early. `chat restart` is the escape for a wrapper whose child
        // is crash-looping.
        const existing = wrapperPids(workspace);
        if (existing.length > 0)
        {
            console.log(`chat already running for '${project}' on :${port} (wrapper pid ${existing[0]})`);
            return;
        }
        const env = {
            ...process.env,
            DEVIN_PROJECT_DIR: workspace,
            AGENT_COORD_DIR: stateDirOf(workspace),
            COORD_CHAT_PORT: String(port),
            COORD_PROJECT: project,
            COORD_CHAT_ID: coord.human ?? process.env.USER ?? "user",
        };
        const child = spawn("bash", ["-c",
            `while true; do node "${path.join(CORE_CHAT, "server.mjs")}" >> "${logFile}" 2>&1; echo "[respawn] exited $(date -Iseconds)" >> "${logFile}"; sleep 1; done`],
            { detached: true, stdio: "ignore", env });
        child.unref();
        writeFileSync(path.join(stateDirOf(workspace), "chat-server.pid"), `${child.pid}\n`, "utf8");
        console.log(`chat started for '${project}' on http://127.0.0.1:${port} (log ${logFile})`);
    }
}

function cmdUpdate(workspace)
{
    const devin = path.join(workspace, ".devin");
    const report = [];
    for (const [name, target] of [["chat", CORE_CHAT], ["hooks", CORE_HOOKS]])
    {
        const link = path.join(devin, name);
        const stat = lstatSync(link, { throwIfNoEntry: false });
        if (!stat)
            report.push(`${name}: MISSING (run coord init)`);
        else if (stat.isSymbolicLink())
            report.push(`${name}: linked → ${readlinkSync(link)}${readlinkSync(link) === target ? " (ok)" : " (STALE)"}`);
        else
            report.push(`${name}: real dir present — DIVERGED copy, diff against ${target} before removing`);
    }
    const coord = coordJsonOf(workspace);
    const project = coord?.project ?? path.basename(workspace);
    for (const [label, configured] of [["team", coord?.teamSkill ?? `${project}-team`], ["recess", coord?.recessSkill ?? `${project}-recess`]])
    {
        const dir = path.join(devin, "skills", configured);
        const skillFile = path.join(dir, "SKILL.md");
        const stat = lstatSync(dir, { throwIfNoEntry: false });
        if (!stat)
            report.push(`${label} skill (${configured}): MISSING`);
        else if (stat.isSymbolicLink())
            report.push(`${label} skill (${configured}): linked → ${readlinkSync(dir)}`);
        else if (existsSync(skillFile))
            report.push(`${label} skill (${configured}): present`);
        else
            report.push(`${label} skill (${configured}): dir present but no SKILL.md — check ${skillFile}`);
    }
    for (const doc of ["COORDINATION.md", "ORGANICS.md"])
        report.push(`${doc}: ${existsSync(path.join(workspace, doc)) ? "present" : "missing (run coord init)"}`);
    console.log(report.join("\n"));
}

function cmdIdentityAdd(name, flags)
{
    if (!name)
        fail("identity add needs a name");
    const dir = path.join(AGENTS_DIR, name);
    mkdirSync(dir, { recursive: true });
    const identityFile = path.join(dir, "identity.md");
    if (!existsSync(identityFile))
        writeFileSync(identityFile, `---\nname: ${name}\ndisplayName: ${flags.display ?? name}\ncolor: null\n---\n\n# ${flags.display ?? name}\n\nPersonality notes live here — how ${name} talks, what they care about, quirks worth keeping. Team-level defaults are in ORGANICS.md per workspace; this file is the person.\n\n## Interests\n\nWhat ${name} reaches for when work pulls are equal — biases that actually change which item gets picked.\n\n## Disinterests\n\nWork ${name} would rather hand off — say it in the room instead of letting it rot in reluctance.\n`, "utf8");
    const memoryFile = path.join(dir, "memory.md");
    if (!existsSync(memoryFile))
        writeFileSync(memoryFile, `# ${name} — memory\n\nAppend-only notebook. Sessions add what they learn; nothing here is workspace-specific — it follows the person.\n`, "utf8");
    console.log(`identity '${name}' at ${dir}`);
}

const [cmd, sub, ...rest] = process.argv.slice(2);
const flags = parseFlags(rest);
const positional = [sub, ...flags._];

switch (cmd)
{
    case "init": cmdInit(positional[0] ? path.resolve(positional[0]) : null, flags); break;
    case "seat":
        if (positional[0] !== "add")
            fail("seat supports: add");
        cmdSeatAdd(positional[1] ? path.resolve(positional[1]) : null, positional[2]);
        break;
    case "chat":
        if (!["start", "stop", "status", "restart"].includes(positional[0] ?? ""))
            fail("chat supports: start|stop|status|restart");
        cmdChat(positional[0], positional[1] ? path.resolve(positional[1]) : null, flags);
        break;
    case "update": cmdUpdate(positional[0] ? path.resolve(positional[0]) : process.cwd()); break;
    case "identity":
        if (positional[0] !== "add")
            fail("identity supports: add");
        cmdIdentityAdd(positional[1], flags);
        break;
    default:
        console.log(readFileSync(fileURLToPath(import.meta.url), "utf8").split("\n").slice(1, 24).join("\n"));
}
