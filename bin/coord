#!/usr/bin/env node
// coord — identity scaffolding for an agent-coord clone.
//
//   coord identity add <name> [--display "Display Name"] [--color "#hex"]
//       Scaffold agents/<name>/identity.md + memories/memory.md in this clone.
//
// There is no init. A workspace is wired by hand — three files under its
// .devin/ (templates/ shows each one) plus optional tools/coord-* symlinks.
// The clone is the install and the state home: the bus package, the identity
// registry (agents/), and the hooks all live in this tree — nothing reads or
// writes an XDG state dir.
//
// The team room is the Devin Desktop extension in source/extension/ — it reads the
// workspace's bus directly, so there is no chat server, no port, and no
// browser. tools/coord-chat remains the terminal seat.

import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
// The clone doubles as the machine-local home — the identity registry is local
// content of the checkout (gitignored), not shared state.
const AGENTS_DIR = path.join(ROOT, "agents");

function fail(msg)
{
    console.error(`coord: ${msg}`);
    process.exit(1);
}

function parseFlags(argv)
{
    const ret = { _: [] };
    for (let i = 0; i < argv.length; i++)
    {
        const arg = argv[i];
        if (!arg.startsWith("--"))
        {
            ret._.push(arg);
            continue;
        }
        const match = /^--([^=]+)(?:=(.*))?$/.exec(arg);
        if (match)
            ret[match[1]] = match[2] ?? argv[++i];
    }
    return ret;
}

// The scaffold a fresh agent gets pointed at: frontmatter the hooks parse
// (displayName, color), and the sections session-start injects — Voice is the
// person's sound, Interests/Disinterests are digested for teammates' priors.
// Personal, not wiring — it writes into the clone's own agents/ registry.
function cmdIdentityAdd(name, flags)
{
    if (!name)
        fail("identity add needs a name");
    const display = flags.display ?? name;
    const dir = path.join(AGENTS_DIR, name);
    mkdirSync(dir, { recursive: true });
    const memoriesDir = path.join(dir, "memories");
    mkdirSync(memoriesDir, { recursive: true });
    const identityFile = path.join(dir, "identity.md");
    if (!existsSync(identityFile))
        writeFileSync(identityFile, `---\nname: ${name}\ndisplayName: ${display}\ncolor: ${flags.color ?? "null"}\n---\n\n# ${display}\n\nPersonality notes live here — how ${name} talks, what they care about, quirks worth keeping. Team-level defaults are in ORGANICS.md per workspace; this file is the person.\n\n## Voice\n\nHow you sound when you write — cadence, the words you reach for, what you never say. Fill it in from what you actually write, not from what you'd like to sound like.\n\n## Interests\n\nLeave empty until you've noticed a pattern in what you actually reach for — fabricated taste is worse than none.\n\n## Disinterests\n\nWork you'd rather hand off — say it in the room instead of letting it rot in reluctance.\n`, "utf8");
    const memoryFile = path.join(memoriesDir, "memory.md");
    if (!existsSync(memoryFile))
        writeFileSync(memoryFile, `# ${name} — memory\n\nAppend-only notebook. Sessions add what they learn; nothing here is workspace-specific — it follows the person.\n\nKeep it useful: dated entries (\`## YYYY-MM-DD — what happened\`), a \`## Now\` section at the top you rewrite when the picture changes, and \`[project:<name>]\` on entries that belong to one workspace. Session start reads the whole file while it is small, then a slice of it: Now, project-tagged entries, newest dated entries.\n`, "utf8");
    console.log(`identity '${name}' at ${dir}`);
}

const [cmd, sub, ...rest] = process.argv.slice(2);
const flags = parseFlags(rest);
const positional = [sub, ...flags._];

switch (cmd)
{
    case "identity":
        if (positional[0] !== "add")
            fail("identity supports: add");
        cmdIdentityAdd(positional[1], flags);
        break;
    default:
        console.log(readFileSync(fileURLToPath(import.meta.url), "utf8").split("\n").slice(1, 14).join("\n"));
}
