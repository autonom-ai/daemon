{
	"configurations": [
		{
			"excludedSourceFiles": [
				"source/tests/**"
			],
			"mainSourceFile": "source/app.d",
			"name": "daemon",
			"sourcePaths": [
				"source/daemon"
			],
			"targetName": "autonom-daemon",
			"targetType": "executable"
		},
		{
			"dependencies": {
				"unit-threaded": "2.2.6"
			},
			"excludedSourceFiles": [
				"source/app.d"
			],
			"mainSourceFile": "bin/ut.d",
			"name": "unit",
			"preBuildCommands": [
				"$DUB build --compiler=$DC --config=daemon",
				"$DUB build --compiler=$DC --config=relay",
				"$DUB run unit-threaded@2.2.6 -c gen_ut_main -- -f bin/ut.d source/tests"
			],
			"sourcePaths": [
				"source/daemon",
				"source/tests"
			],
			"targetName": "autonom-unit",
			"targetType": "executable"
		},
		{
			"excludedSourceFiles": [
				"source/tests/**"
			],
			"mainSourceFile": "source/app.d",
			"name": "relay",
			"sourcePaths": [
				"source/daemon"
			],
			"targetName": "autonom-acp",
			"targetType": "executable"
		}
	],
	"dependencies": {
		"arsd-official:sqlite": "~>12.1.2",
		"intuit": "2.0.0",
		"mir-ion": "2.3.5",
		"serverino": "0.8.5"
	},
	"description": "Autonom state and session API daemon.",
	"importPaths": [
		"source"
	],
	"license": "AGPL-3.0-only",
	"name": "autonom",
	"sourcePaths": [],
	"targetPath": "bin",
	"targetType": "executable"
}
