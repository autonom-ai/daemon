{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{COORD_ROOT}}/core/hooks/session-start.mjs\"",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{COORD_ROOT}}/core/hooks/prompt-context.mjs\"",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^(edit|write|apply_patch|notebook_edit|exec|write_to_process)$",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{COORD_ROOT}}/core/hooks/recess-guard.mjs\"",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^mcp__agent-coord-.*__(join|register)$",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{COORD_ROOT}}/core/hooks/record-join.mjs\"",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{COORD_ROOT}}/core/hooks/tool-log.mjs\"",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{COORD_ROOT}}/core/hooks/keep-alive.mjs\"",
          "timeout": 10
        }
      ]
    }
  ]
}
