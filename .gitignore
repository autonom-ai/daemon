.dub/
bin/
.env
test-workspace
.agents/
.autonom-worktrees/
.playwright-mcp/
__pycache__

# Workspace coordination files stay private; only the Command Center example is shared.
.devin/
!/.devin/
/.devin/*
!/.devin/commandCenter.json
!/.devin/hello.html
!/.devin/notes.html

# Documentation is private except the Command Center contract and validation method.
docs/*
!/docs/
!/docs/COMMAND_CENTER.md
!/docs/COMMAND_CENTER_VALIDATION.md

extension/node_modules/
extension/dist/
extension/LICENSE.txt

# Build, packaging, and reverse-engineering harness are part of the extension contract.
/extension/.devin/*
!/extension/.devin/
!/extension/.devin/build.mjs
!/extension/.devin/packageignore
!/extension/.devin/cdp.mjs
!/extension/.devin/analyze.mjs
