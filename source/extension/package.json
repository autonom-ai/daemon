{
  "name": "agent-coord",
  "displayName": "Agent Coord Chat",
  "description": "Unified chat interface for agent-coord sessions.",
  "publisher": "cet",
  "version": "0.2.1",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:.devin/coord.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentCoord",
          "title": "Team Room",
          "icon": "media/room.svg"
        }
      ]
    },
    "views": {
      "agentCoord": [
        {
          "type": "webview",
          "id": "agentCoord.chat",
          "name": "Team Room"
        }
      ]
    },
    "commands": [
      {
        "command": "agentCoord.focus",
        "title": "Open the team room",
        "category": "Team Room"
      },
      {
        "command": "agentCoord.openPanel",
        "title": "Open the team room in a tab",
        "category": "Team Room"
      },
      {
        "command": "agentCoord.refresh",
        "title": "Refresh",
        "category": "Team Room"
      }
    ],
    "configuration": {
      "title": "Team Room",
      "properties": {
        "agentCoord.workspace": {
          "type": "string",
          "default": "",
          "description": "Workspace directory whose .devin/coord.json wires it to a team. Empty means the open folder that has one."
        },
        "agentCoord.coordRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the agent-coord clone (store module, hooks, identities). Empty means coordRoot from the workspace's coord.json."
        }
      }
    }
  }
}
