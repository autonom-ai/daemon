{
  "name": "autonom-launcher",
  "description": "Launches Devin Desktop with the Autonom Command Center attached over a private debugging pipe.",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node build.mjs",
    "test": "npm run build && node --test ../../dist/tests/unit/*.js",
    "launch": "npm run build && node ../../dist/launcher.js"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "esbuild": "0.25.9",
    "typescript": "5.9.3"
  }
}
