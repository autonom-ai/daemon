{
  "name": "autonom",
  "displayName": "Autonom Command Center",
  "description": "Autonom provider switch for the Devin Desktop Agent Command Center (proof of concept).",
  "version": "0.4.0",
  "publisher": "cet",
  "repository": {
    "type": "git",
    "url": "https://github.com/cetio/agent-coord.git"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "icon": "media/autonom.svg",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:autonom.applyPatch",
    "onCommand:autonom.restore",
    "onCommand:autonom.status",
    "onCommand:autonom.hotReload"
  ],
  "contributes": {
    "commands": [
      {
        "command": "autonom.applyPatch",
        "title": "Apply Command Center Patch",
        "category": "Autonom"
      },
      {
        "command": "autonom.restore",
        "title": "Restore Original Bundles",
        "category": "Autonom"
      },
      {
        "command": "autonom.status",
        "title": "Show Patch Status",
        "category": "Autonom"
      },
      {
        "command": "autonom.hotReload",
        "title": "Hot-Reload Companion UI",
        "category": "Autonom"
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node .devin/build.mjs",
    "test": "npm run build && node --test dist/tests/*.js",
    "package:files": "vsce ls --no-dependencies --ignoreFile .devin/packageignore",
    "package": "npm run build && vsce package --no-dependencies --ignoreFile .devin/packageignore --out ../bin/autonom-0.4.0.vsix"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.25.9",
    "typescript": "5.9.3"
  }
}
