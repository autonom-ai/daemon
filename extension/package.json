{
  "name": "autonom-coord",
  "displayName": "Autonom Team Room",
  "description": "The human's seat on the autonom coord bus: rooms, DMs, and pings in a Devin Desktop tab.",
  "publisher": "cet",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:.devin/autonom-config.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autonomCoord",
          "title": "Team Room",
          "icon": "media/room.svg"
        }
      ]
    },
    "views": {
      "autonomCoord": [
        {
          "type": "webview",
          "id": "autonomCoord.chat",
          "name": "Team Room"
        }
      ]
    },
    "commands": [
      {
        "command": "autonomCoord.focus",
        "title": "Open the team room",
        "category": "Team Room"
      },
      {
        "command": "autonomCoord.openPanel",
        "title": "Open the team room in a tab",
        "category": "Team Room"
      },
      {
        "command": "autonomCoord.refresh",
        "title": "Refresh",
        "category": "Team Room"
      }
    ],
    "configuration": {
      "title": "Team Room",
      "properties": {
        "autonomCoord.workspace": {
          "type": "string",
          "default": "",
          "description": "Workspace directory whose .devin/autonom-config.json wires it to a team. Empty means the open folder that has one."
        },
        "autonomCoord.coordRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the autonom clone (profiles, DMs, pings)."
        }
      }
    }
  }
}
