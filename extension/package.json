{
  "name": "autonom-command-center",
  "displayName": "Autonom Command Center",
  "description": "Runtime-only native Command Center configuration for Devin Desktop.",
  "version": "0.5.2",
  "publisher": "cet",
  "repository": {
    "type": "git",
    "url": "https://github.com/cetio/agent-coord.git"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:autonomCenter.attach",
    "onCommand:autonomCenter.reload",
    "onCommand:autonomCenter.hotReload",
    "onCommand:autonomCenter.disable",
    "onCommand:autonomCenter.status",
    "onCommand:autonomCenter.openTab",
    "onCommand:autonomCenter.editConfig",
    "onCommand:autonomCenter.bridgeIdentity",
    "onCommand:autonomCenter.daemonRequest",
    "onCommand:autonomCenter.setMode"
  ],
  "contributes": {
    "commands": [
      {
        "command": "autonomCenter.attach",
        "title": "Attach",
        "category": "Autonom Command Center"
      },
      {
        "command": "autonomCenter.reload",
        "title": "Reload Configuration",
        "category": "Autonom Command Center"
      },
      {
        "command": "autonomCenter.hotReload",
        "title": "Hot Reload Native Runtime",
        "category": "Autonom Command Center"
      },
      {
        "command": "autonomCenter.disable",
        "title": "Disable",
        "category": "Autonom Command Center"
      },
      {
        "command": "autonomCenter.status",
        "title": "Show Native Status",
        "category": "Autonom Command Center"
      },
      {
        "command": "autonomCenter.openTab",
        "title": "Open Tab",
        "category": "Autonom Command Center"
      },
      {
        "command": "autonomCenter.editConfig",
        "title": "Edit Configuration",
        "category": "Autonom Command Center"
      },
      {
        "command": "autonomCenter.setMode",
        "title": "Set Provider Mode",
        "category": "Autonom Command Center"
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node .devin/build.mjs",
    "test": "npm run build && node --test dist/tests/*.js",
    "package:files": "vsce ls --no-dependencies --ignoreFile .devin/packageignore",
    "package": "npm run build && vsce package --no-dependencies --ignoreFile .devin/packageignore --out ../bin/autonom-command-center-0.5.2.vsix"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.25.9",
    "typescript": "5.9.3"
  }
}
